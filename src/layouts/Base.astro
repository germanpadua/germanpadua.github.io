---
import { Font } from 'astro:assets';
import ThemeScript from '../components/ThemeScript.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { identity, useTranslations, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Keep working pages out of the index without hiding them. */
  noindex?: boolean;
  /** Route pair used for canonical and hreflang links. */
  alternate?: { es: string; en: string };
  /** The lab renders its own chrome and needs the full width. */
  chrome?: boolean;
  /**
   * Sections this page actually renders. Required rather than defaulted: the nav
   * and the footer must never advertise an anchor that does not exist.
   */
  navLinks: { href: string; label: string }[];
}

const {
  locale,
  title,
  description,
  noindex = false,
  alternate = { es: '/', en: '/en/' },
  chrome = true,
  navLinks,
} = Astro.props;

const t = useTranslations(locale);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(alternate[locale], identity.site).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  jobTitle: locale === 'es' ? 'Científico de datos' : 'Data scientist',
  email: `mailto:${identity.email}`,
  url: identity.site,
  address: { '@type': 'PostalAddress', addressCountry: 'ES', addressLocality: 'Almería' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad de Granada',
  },
  knowsAbout: [
    'Machine learning',
    'Statistics',
    'Credit risk modelling',
    'IFRS 9',
    'Anomaly detection',
    'Data engineering',
    'Large language models',
  ],
  sameAs: [identity.github, identity.linkedin],
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(alternate.es, identity.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternate.en, identity.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternate.es, identity.site).href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_GB' : 'es_ES'} />
    <meta property="og:image" content={new URL('/og-default.png', identity.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${identity.name} — ${t.hero.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <meta name="theme-color" content="#f6f4ee" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={identity.name} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    {/* Must run before first paint: sets data-theme so no palette flashes. */}
    <ThemeScript />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    {chrome && <Nav locale={locale} alternate={alternate} links={navLinks} />}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {chrome && <Footer locale={locale} alternate={alternate} links={navLinks} />}
  </body>
</html>
