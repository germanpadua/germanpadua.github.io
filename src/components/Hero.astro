---
import { useTranslations, type Locale } from '../i18n/ui';
import ResearchPreview from './ResearchPreview.astro';
interface Props { locale: Locale; primaryHref: string; secondaryHref?: string }
const { locale, primaryHref } = Astro.props;
const t = useTranslations(locale);
---
<section id="top" class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">{t.hero.headline}</h1>
      <p class="hero__support">{t.hero.support}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={primaryHref}>{t.hero.primaryAction}</a>
      </div>
    </div>

    <a
      class="hero__stage"
      href={locale === 'es' ? '/proyectos/pseudo-riemannian-gnn/' : '/en/projects/pseudo-riemannian-gnn/'}
      aria-label={locale === 'es' ? 'Explorar mi TFG: geometría y redes neuronales para grafos' : 'Explore my thesis: geometry and graph neural networks'}
    >
      <ResearchPreview wide locale={locale} />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: -4.5rem;
    padding-top: calc(4.5rem + clamp(1.75rem, 4vw, 3.25rem));
    padding-bottom: clamp(2.5rem, 5vw, 4.25rem);
    background:
      radial-gradient(ellipse 75% 55% at 50% 0%, color-mix(in srgb, var(--accent) 11%, transparent), transparent 72%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg-inset) 65%, transparent) 0%, var(--bg) 55%);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: clamp(1.75rem, 3.2vw, 2.75rem);
    justify-items: center;
  }

  .hero__copy {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-s);
    max-width: 64rem;
    width: 100%;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6.8vw, 6.2rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    font-weight: 500;
    color: var(--fg-strong);
    max-width: 16ch;
    text-wrap: balance;
  }

  .hero__support {
    font-size: var(--text-body);
    color: var(--fg-muted);
    max-width: 50ch;
    line-height: var(--leading-normal);
  }

  .hero__actions {
    margin-top: var(--space-3xs);
  }

  .hero__stage {
    display: block;
    width: 100%;
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .hero__stage:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  @keyframes hero-enter {
    from {
      opacity: 0.01;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title {
      animation: hero-enter 420ms var(--ease-out) both;
    }

    .hero__support,
    .hero__actions {
      animation: hero-enter 480ms var(--ease-out) 60ms both;
    }

    .hero__stage {
      animation: hero-enter 560ms var(--ease-out) 120ms both;
    }
  }

  @media (max-width: 75rem) {
    .hero {
      margin-top: -6.5rem;
      padding-top: calc(6.5rem + clamp(1.5rem, 4vw, 2.75rem));
    }
  }

  @media (max-width: 48rem) {
    .hero {
      margin-top: -6.25rem;
      padding-top: calc(6.25rem + 1.5rem);
    }

    .hero__copy {
      justify-items: start;
      text-align: left;
    }

    .hero__title {
      font-size: clamp(2.65rem, 11vw, 3.6rem);
      max-width: 14ch;
    }
  }
</style>
