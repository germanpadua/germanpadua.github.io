---
import { identity, useTranslations, type Locale } from '../i18n/ui';
import ResearchPreview from './ResearchPreview.astro';
interface Props { locale: Locale; primaryHref: string; secondaryHref: string }
const { locale, primaryHref, secondaryHref } = Astro.props;
const t = useTranslations(locale);
---
<section id="top" class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__identity">{identity.name} <span>{identity.location[locale]}</span></p>
      <h1 class="hero__title">{t.hero.headline}</h1>
      <p class="hero__support">{t.hero.support}</p>
      <div class="cluster hero__actions">
        <a class="btn btn--primary" href={primaryHref}>{t.hero.primaryAction}</a>
        <a class="btn" href={secondaryHref}>{t.hero.secondaryAction}</a>
      </div>
    </div>
    <a class="hero__research" href={locale === 'es' ? '/proyectos/pseudo-riemannian-gnn/' : '/en/projects/pseudo-riemannian-gnn/'} aria-label={locale === 'es' ? 'Explorar mi TFG: geometría y redes neuronales para grafos' : 'Explore my thesis: geometry and graph neural networks'}>
      <ResearchPreview locale={locale} />
      <p>{locale === 'es' ? 'Una idea llevada a código: geometría y redes neuronales para grafos.' : 'An idea brought to code: geometry and graph neural networks.'}</p>
    </a>
  </div>
</section>
<style>
 .hero__inner { display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; gap: clamp(2rem,6vw,6rem); padding-block: clamp(3rem,7vw,6.5rem); }
 .hero__identity { color: var(--fg-strong); font-size: var(--step-0); margin-bottom: 1.6rem; font-weight: 600; }
 .hero__identity span { display: block; font-size: var(--step--1); color: var(--fg-muted); font-weight: 400; margin-top: .2rem; }
 .hero__title { font-size: clamp(2.8rem,4.9vw,4.8rem); line-height: 1.08; letter-spacing: -.035em; max-width: 15ch; font-weight: 500; }
 .hero__support { font-size: var(--step-0); color: var(--fg-muted); max-width: 51ch; line-height: 1.7; margin-top: 1.5rem; }
 .hero__actions { margin-top: 1.75rem; }
 .hero__research { text-decoration: none; display: block; min-width: 0; }
 .hero__research > p { color: var(--fg-muted); font-size: var(--step--1); max-width: 43ch; margin: 1rem 0 0; }
 .hero__research:hover > p { color: var(--accent); }
 @media (max-width: 52rem) { .hero__inner { grid-template-columns: 1fr; gap: 2rem; } .hero__title { max-width: 17ch; } .hero__research { max-width: 28rem; } }
</style>
