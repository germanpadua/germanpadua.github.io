---
import AreaPreview from './AreaPreview.astro';
import SkillDirectory from './SkillDirectory.astro';
import { skillMapPath } from '../lib/content';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

---

<section id="skills" class="section">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.sections.skills.eyebrow}</p>
      <h2>{t.sections.skills.title}</h2>
      <p class="section-head__lead">{t.sections.skills.lead}</p>
    </header>

    <AreaPreview locale={locale} />

    <p class="skills__cta"><a class="btn" href={skillMapPath(locale)}>{t.sections.skills.cta}</a></p>
    <p class="skills__context">{locale === 'es' ? 'Un mapa de lo que he estudiado y de lo que utilizo. Cada nodo enlaza con su formación y, cuando corresponde, con proyectos donde lo he aplicado.' : 'A map of what I have studied and what I use. Each node shows its coursework and, where applicable, projects where I have applied it.'}</p>

    <SkillDirectory locale={locale} />
  </div>
</section>

<style>
  .skills__cta { margin-bottom: 1.25rem; }
  .skills__context { max-width: 68ch; font-size: var(--step--1); color: var(--fg-muted); margin-bottom: 1.5rem; }
</style>
