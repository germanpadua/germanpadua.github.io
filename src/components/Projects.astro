---
import { Picture } from 'astro:assets';
import ResearchPreview from './ResearchPreview.astro';
import TelemetryPreview from './TelemetryPreview.astro';
import { projectImage } from '../lib/projectImages';
import { getFeaturedProjects, getSupportingProjects, projectPath, projectsIndexPath } from '../lib/content';
import { useTranslations, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const featured = await getFeaturedProjects(locale);
const supporting = await getSupportingProjects(locale);
---
<section id="projects" class="section">
  <div class="container">
    <header class="section-head"><h2>{t.sections.projects.title}</h2><p class="section-head__lead">{t.sections.projects.lead}</p></header>
    <ul class="selected-projects" role="list">
      {featured.map(({data}) => <li class="selected-project">
        <a class="selected-project__visual" href={projectPath(locale,data.slug)} aria-label={data.title}>
          {data.slug === 'pseudo-riemannian-gnn' ? <ResearchPreview compact locale={locale} /> : data.slug === 'telemetry-sentinel' ? <TelemetryPreview locale={locale} /> : data.images[0] ? <Picture src={projectImage(data.images[0].file)} alt={data.images[0].alt} widths={[480,900]} sizes="(max-width: 48rem) 92vw, 42vw" formats={['avif','webp']} loading="lazy" decoding="async" /> : <div class="selected-project__plain"><span>{data.domains[0]}</span><strong>{data.title}</strong><p>{data.stack.slice(0,3).join(' / ')}</p></div>}
        </a>
        {data.images[0]?.caption && <p class="selected-project__image-note">{locale === "es" ? "Vista ilustrativa" : "Illustrative view"}</p>}
        <div class="selected-project__heading"><h3><a href={projectPath(locale,data.slug)}>{data.title}</a></h3><span>{t.projects.statuses[data.status]}</span></div>
        <p class="selected-project__summary">{data.summary}</p>
        <p class="selected-project__stack">{data.stack.slice(0,4).join(' · ')}</p>
        <div class="cluster selected-project__links"><a href={projectPath(locale,data.slug)}>{locale === 'es' ? 'Explorar proyecto' : 'Explore project'}</a>{data.links.demo ? <a href={data.links.demo} target="_blank" rel="noopener noreferrer">{t.projects.demo}</a> : data.links.repo && <a href={data.links.repo} target="_blank" rel="noopener noreferrer">GitHub</a>}</div>
      </li>)}
    </ul>
    <details class="other-projects"><summary>{t.projects.more}</summary><ul role="list">{supporting.map(({data}) => <li><a href={projectPath(locale,data.slug)}>{data.title}</a><p>{data.summary}</p></li>)}</ul></details>
    <p class="projects__all"><a class="btn" href={projectsIndexPath(locale)}>{locale === 'es' ? 'Ver todos los proyectos' : 'See all projects'}</a></p>
  </div>
</section>
<style>
 .selected-projects { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 3.5rem 2.5rem; }
 .selected-project { min-width: 0; }
 .selected-project__visual { display: flex; align-items: center; justify-content: center; aspect-ratio: 1.55; background: var(--bg-inset); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-decoration: none; margin-bottom: 1.2rem; }
 .selected-project__visual :global(picture) { width: 100%; height: 100%; }
 .selected-project__visual :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; }
 .selected-project__visual :global(.research-preview) { width: 100%; height: 100%; }
 .selected-project__visual :global(.research-preview svg) { height: calc(100% - 3rem); width: 100%; }
 .selected-project__plain { width: 100%; padding: clamp(1.5rem,4vw,3rem); }
 .selected-project__plain span { font-size: .8rem; color: var(--fg-muted); }
 .selected-project__plain strong { display: block; font-family: var(--font-display); font-size: clamp(1.7rem,2.5vw,2.7rem); line-height: 1.15; color: var(--fg-strong); max-width: 17ch; margin-block: .75rem; }
 .selected-project__plain p { font-size: .8rem; color: var(--fg-muted); }
 .selected-project__image-note { font-size: .7rem; color: var(--fg-muted); margin-top: -.7rem; margin-bottom: .8rem; }
 .selected-project__heading { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; }
 .selected-project__heading h3 { font-size: var(--step-2); line-height: 1.25; }
 .selected-project__heading h3 a { text-decoration: none; color: var(--fg-strong); }
 .selected-project__heading span { font-size: .75rem; color: var(--fg-muted); flex: none; }
 .selected-project__summary { color: var(--fg); font-size: var(--step--1); line-height: 1.65; margin-top: .75rem; }
 .selected-project__stack { font-size: .75rem; color: var(--fg-muted); margin-top: .75rem; }
 .selected-project__links { margin-top: 1rem; font-size: var(--step--1); gap: 1.5rem; }
 .other-projects { margin-top: 3rem; border-block: 1px solid var(--border); padding-block: 1rem; }
 .other-projects summary { cursor: pointer; font-size: var(--step-1); }
 .other-projects ul { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2.5rem; margin-block: 1.5rem; }
 .other-projects li p { font-size: .85rem; color: var(--fg-muted); margin-top: .4rem; }
 .projects__all { margin-top: 1.5rem; }
 @media(max-width:48rem) { .selected-projects,.other-projects ul { grid-template-columns: 1fr; } .selected-project__image-note { font-size: .7rem; color: var(--fg-muted); margin-top: -.7rem; margin-bottom: .8rem; }
 .selected-project__heading { flex-wrap: wrap; } }
</style>
