---
/**
 * The home page composition, shared by both locales.
 *
 * Owns the section list and hands it to Base, which is what keeps the nav and the
 * footer pointing only at sections that exist on this route.
 *
 * Order is deliberate: identity, then what he has built, then the recognitions,
 * then the track record, then the toolbox, then the interactive layer and the
 * personal note. A recruiter who reads three sections has read the three that
 * matter.
 */
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Profile from './Profile.astro';
import Projects from './Projects.astro';
import Highlights from './Highlights.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import Education from './Education.astro';
import Playground from './Playground.astro';
import Contact from './Contact.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const navLinks = [
  { href: '#about', label: t.nav.about },
  { href: '#projects', label: t.nav.projects },
  { href: '#work', label: t.nav.work },
  { href: '#skills', label: t.nav.skills },
  { href: '#education', label: t.nav.education },
  { href: '#contact', label: t.nav.contact },
];

---

<Base locale={locale} alternate={{ es: '/', en: '/en/' }} navLinks={navLinks}>
  <Hero locale={locale} primaryHref="#projects" secondaryHref="#work" />
  <Profile locale={locale} />
  <Projects locale={locale} />
  <Highlights locale={locale} />
  <Experience locale={locale} />
  <Skills locale={locale} />
  <Education locale={locale} />
  <Playground locale={locale} />
  <Contact locale={locale} />
</Base>
