---
/**
 * The home page composition, shared by both locales.
 *
 * Owns the section list and hands it to Base, which is what keeps the nav and the
 * footer pointing only at sections that exist on this route.
 */
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Profile from './Profile.astro';
import Playground from './Playground.astro';
import Contact from './Contact.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const navLinks = [
  { href: '#about', label: t.nav.about },
  { href: '#playground', label: t.nav.playground },
  { href: '#contact', label: t.nav.contact },
];

const portrait = {
  src: '/images/portrait.jpg',
  width: 760,
  height: 762,
  alt:
    locale === 'es'
      ? 'Retrato de German Padua'
      : 'Portrait of German Padua',
};
---

<Base
  locale={locale}
  alternate={{ es: '/', en: '/en/' }}
  navLinks={navLinks}
>
  <Hero locale={locale} primaryHref="#playground" secondaryHref="#about" />
  <Profile locale={locale} portrait={portrait} />
  <Playground locale={locale} />
  <Contact locale={locale} />
</Base>
