---
import ThemeSwitch from './ThemeSwitch.astro';
import { identity, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  alternate: { es: string; en: string };
  /** Only sections the page actually renders, so no anchor is ever dead. */
  links: { href: string; label: string }[];
}

const { locale, alternate, links } = Astro.props;
const t = useTranslations(locale);

const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__brand" href={locale === 'es' ? '/' : '/en/'}>
      <span class="nav__brand-text">
        <span class="nav__brand-name">{identity.name}</span>
        <span class="nav__brand-role">{t.hero.eyebrow}</span>
      </span>
    </a>

    <nav class="nav__links" aria-label={t.nav.label}>
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__tools">
      <button type="button" class="nav__terminal" data-terminal-open hidden aria-haspopup="dialog" aria-controls="terminal-mode" aria-expanded="false" title={locale === 'es' ? 'Abrir modo terminal' : 'Open terminal mode'}>
        <span aria-hidden="true">&gt;_</span><span class="sr-only">{locale === 'es' ? 'Abrir modo terminal' : 'Open terminal mode'}</span>
      </button>
      <ThemeSwitch />
      <a
        class="nav__lang"
        href={alternate[otherLocale]}
        hreflang={otherLocale}
        lang={otherLocale}
        title={t.nav.languageLabel}
      >
        {t.nav.languageShort}
        <span class="sr-only"> · {t.nav.languageLabel}</span>
      </a>
    </div>
  </div>
  <details class="nav__mobile container">
    <summary>{locale === 'es' ? 'Secciones' : 'Sections'}</summary>
    <nav aria-label={t.nav.label}>
      <ul role="list">{links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </nav>
  </details>
</header>

<script is:inline>
  (()=>{const m=document.querySelector('.nav__mobile');m?.addEventListener('click',e=>{if(e.target.closest('a'))m.open=false});const h=document.querySelector('[data-nav]');if(!h)return;const s=()=>h.toggleAttribute('data-scrolled',window.scrollY>12);s();window.addEventListener('scroll',s,{passive:true})})();
</script>

<style>
  .nav__mobile { display: none; }
  .nav__mobile summary { cursor: pointer; padding-block: .5rem; font-size: var(--text-sm); color: var(--fg-muted); }
  .nav__mobile ul { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding-block: .5rem 1rem; }
  .nav__mobile a { font-size: var(--text-sm); text-decoration: none; }
  .nav__terminal { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; flex: none; border: var(--rule) var(--border-style) var(--border); border-radius: var(--radius-pill); background: var(--bg-inset); font-family: var(--font-code); font-size: var(--text-sm); color: var(--fg-muted); transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out); }
  .nav__terminal:hover, .nav__terminal[aria-expanded="true"] { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .nav__terminal[hidden] { display: none; }
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background-color: transparent;
    border-bottom: var(--rule) var(--border-style) transparent;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .nav[data-scrolled] {
    background-color: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4.5rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    margin-right: auto;
    text-decoration: none;
    flex: none;
    min-width: 0;
    max-width: 20rem;
  }

  .nav__brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.1;
  }

  .nav__brand-name {
    font-family: var(--font-display);
    color: var(--fg-strong);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  .nav__brand-role {
    display: none;
  }

  .nav__links ul {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }

  .nav__links {
    flex: none;
  }

  .nav__links a {
    display: block;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .nav__links a:hover {
    color: var(--fg-strong);
    background-color: var(--bg-hover);
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex: none;
  }

  .nav__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-muted);
    text-decoration: none;
    padding: 0.25rem 0.65rem;
    border: var(--rule) var(--border-style) var(--border);
    border-radius: var(--radius-pill);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .nav__lang:hover {
    color: var(--fg-strong);
    border-color: var(--border-strong);
  }

  /* Leave room for the brand and all tools before revealing section links. */
  @media (max-width: 75rem) {
    .nav__mobile { display: block; }
    .nav__links {
      display: none;
    }
  }
  @media (max-width: 30rem) {
    .nav__inner { gap: .4rem; min-height: 3.75rem; }
    .nav__brand-name { font-size: 1.05rem; }
    .nav__tools { gap: .25rem; }
    .nav__lang { padding-inline: .45rem; min-height: 2rem; font-size: 0.8125rem; }
    .nav__terminal { width: 2rem; height: 2rem; }
  }
</style>
