---
import ThemeSwitch from './ThemeSwitch.astro';
import { identity, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  alternate: { es: string; en: string };
  /** Only sections the page actually renders, so no anchor is ever dead. */
  links: { href: string; label: string }[];
}

const { locale, alternate, links } = Astro.props;
const t = useTranslations(locale);

const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={locale === 'es' ? '/' : '/en/'}>
      <span class="nav__brand-mark" aria-hidden="true"></span>
      <span class="nav__brand-text">
        <span class="nav__brand-name">{identity.name}</span>
        <span class="nav__brand-role">{t.hero.eyebrow}</span>
      </span>
    </a>

    <nav class="nav__links" aria-label={t.nav.label}>
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__tools">
      <button type="button" class="nav__terminal" data-terminal-open hidden aria-haspopup="dialog" aria-controls="terminal-mode" aria-expanded="false" title={locale === 'es' ? 'Abrir modo terminal' : 'Open terminal mode'}>
        <span aria-hidden="true">&gt;_</span><span class="sr-only">{locale === 'es' ? 'Abrir modo terminal' : 'Open terminal mode'}</span>
      </button>
      <ThemeSwitch />
      <a
        class="nav__lang"
        href={alternate[otherLocale]}
        hreflang={otherLocale}
        lang={otherLocale}
        title={t.nav.languageLabel}
      >
        {t.nav.languageShort}
        <span class="sr-only"> — {t.nav.languageLabel}</span>
      </a>
    </div>
  </div>
  <details class="nav__mobile container">
    <summary>{locale === 'es' ? 'Secciones' : 'Sections'}</summary>
    <nav aria-label={t.nav.label}>
      <ul role="list">{links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </nav>
  </details>
</header>

<script is:inline>
  document.querySelector('.nav__mobile')?.addEventListener('click',function(e){if(e.target.closest('a'))this.open=false});
</script>

<style>
  .nav__mobile { display: none; }
  .nav__mobile summary { cursor: pointer; padding-block: .45rem; font-size: .8rem; color: var(--fg-muted); }
  .nav__mobile ul { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding-block: .5rem 1rem; }
  .nav__mobile a { font-size: .9rem; text-decoration: none; }
  .nav__terminal { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; flex: none; border: var(--rule) var(--border-style) var(--border); border-radius: var(--radius-pill); background: var(--bg-inset); font-family: var(--font-code); font-size: .85rem; color: var(--fg-muted); }
  .nav__terminal:hover, .nav__terminal[aria-expanded="true"] { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .nav__terminal[hidden] { display: none; }
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    border-bottom: var(--rule) var(--border-style) var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-right: auto;
    text-decoration: none;
    /* Keep each control at its actual width; switch to mobile navigation early. */
    flex: none;
    min-width: 0;
    max-width: 20rem;
  }

  /* The mark is the favicon reduced to its two ideas: a measuring rule and a
     graph node. Drawn in CSS so it re-colours with the theme. */
  .nav__brand-mark {
    flex: none;
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    border: var(--rule) var(--border-style) var(--border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--bg-inset);
  }

  .nav__brand-mark::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.28rem;
    width: var(--rule-strong);
    height: 0.85rem;
    transform: translateX(-50%);
    background-color: var(--accent);
  }

  .nav__brand-mark::after {
    content: "";
    position: absolute;
    inset: 0.28rem 0.28rem auto auto;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: var(--radius-pill);
    background-color: var(--accent-2);
  }

  .nav__brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.15;
  }

  .nav__brand-name {
    color: var(--fg-strong);
    font-weight: 600;
    font-size: var(--step-0);
    letter-spacing: var(--tracking-tight);
  }

  .nav__brand-role {
    display: none;
    font-family: var(--font-code);
    font-size: var(--step--2);
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav__links ul {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }

  .nav__links {
    flex: none;
  }

  .nav__links a {
    display: block;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-standard),
      background-color var(--dur-fast) var(--ease-standard);
  }

  .nav__links a:hover {
    color: var(--fg-strong);
    background-color: var(--bg-hover);
  }

  .nav__tools {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex: none;
  }

  .nav__lang {
    font-family: var(--font-code);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-muted);
    text-decoration: none;
    padding: 0.35rem 0.55rem;
    border: var(--rule) var(--border-style) var(--border);
    border-radius: var(--radius-pill);
  }

  .nav__lang:hover {
    color: var(--fg-strong);
    border-color: var(--border-strong);
  }

  /* Leave room for the brand and all tools before revealing section links. */
  @media (max-width: 75rem) {
    .nav__mobile { display: block; }
    .nav__links {
      display: none;
    }
  }
  @media (max-width: 30rem) {
    .nav__inner { gap: .5rem; }
    .nav__brand-mark { display: none; }
    .nav__brand-name { font-size: .85rem; }
    .nav__brand-name { white-space: nowrap; }
    .nav__tools { gap: .3rem; }
    .nav__lang { padding-inline: .4rem; }
    .nav__terminal { width: 2rem; height: 2rem; }
  }
</style>
