---
import { render } from 'astro:content';
import { getExperience } from '../lib/content';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const roles = await getExperience(locale);

/*
 * Pair each entry with its rendered body here rather than indexing a parallel
 * array inside the template: with `noUncheckedIndexedAccess` a positional lookup
 * is `RenderResult | undefined`, and the index coupling breaks silently the
 * moment the lists diverge.
 */
const rolesWithContent = await Promise.all(
  roles.map(async (role) => ({ role, rendered: await render(role) })),
);

/*
 * Cross-entry invariant the schema cannot express: at least one role has to be
 * current, or the timeline silently loses its present tense and nobody notices
 * until a reader asks what he does now.
 */
if (!roles.some((role) => role.data.end === 'present')) {
  throw new Error(`no experience entry for locale ${locale} is marked as current`);
}
---

<section id="work" class="section section--gridded">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.sections.work.eyebrow}</p>
      <h2>{t.sections.work.title}</h2>
    </header>

    <ol class="timeline" role="list">
      {
        rolesWithContent.map(({ role, rendered }) => {
          const { data } = role;
          const current = data.end === 'present';
          const { Content } = rendered;
          return (
            <li class:list={['role', `role--${data.accent}`, { 'role--current': current }]}>
              <div class="role__when">
                <span class="role__period">{data.period}</span>
                {current && <span class="role__now">{locale === 'es' ? 'hoy' : 'now'}</span>}
              </div>

              <div class="role__body">
                <h3 class="role__title">{data.title}</h3>
                <p class="role__org">
                  {data.organisation}
                  {data.location && <span class="role__place"> · {data.location}</span>}
                </p>

                <p class="role__summary">{data.summary}</p>

                <ul class="role__points" role="list">
                  {data.responsibilities.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>

                <div class="cluster role__meta">
                  {data.regulated && (
                    <span class="chip role__regulated">
                      {locale === 'es' ? 'marco regulado' : 'regulated'}
                    </span>
                  )}
                  {data.stack.map((item) => (
                    <span class="chip">{item}</span>
                  ))}
                </div>

                {/*
                  The prose is the good part and also the long part. A disclosure
                  keeps the timeline scannable for someone skimming in thirty
                  seconds while leaving the depth one click away, with no JavaScript.
                */}
                <details class="role__more">
                  <summary>{locale === 'es' ? 'Más contexto' : 'More context'}</summary>
                  <div class="role__prose">
                    <Content />
                  </div>
                </details>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--rule) var(--border-style) var(--border);
  }

  .role {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--space-m) var(--space-xl);
    padding-block: var(--space-l);
    border-bottom: var(--rule) var(--border-style) var(--border);
  }

  .role__when {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: flex-start;
    position: sticky;
    top: 5rem;
    align-self: start;
  }

  .role__period {
    font-family: var(--font-code);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-muted);
  }

  .role__now {
    font-family: var(--font-code);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-on-accent);
    background-color: var(--accent);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.5rem;
  }

  .role__body {
    display: grid;
    gap: var(--space-2xs);
    max-width: var(--measure);
  }

  .role__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--fg-strong);
  }

  .role__org {
    font-size: var(--step-0);
    color: var(--accent);
    max-width: none;
  }

  .role__place {
    color: var(--fg-faint);
  }

  .role__summary {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--fg);
  }

  .role__points {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .role__points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--fg-muted);
  }

  .role__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.45rem;
    height: var(--rule);
    background-color: var(--border-strong);
  }

  .role__meta {
    margin-top: var(--space-2xs);
  }

  .role__regulated {
    border-color: var(--warn);
    color: var(--warn);
  }

  .role__more {
    margin-top: var(--space-2xs);
  }

  .role__more summary {
    font-family: var(--font-code);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-muted);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .role__more summary::-webkit-details-marker {
    display: none;
  }

  .role__more summary::before {
    content: "+";
    color: var(--accent);
  }

  .role__more[open] summary::before {
    content: "−";
  }

  .role__more summary:hover {
    color: var(--fg-strong);
  }

  .role__prose {
    margin-top: var(--space-s);
    padding-left: var(--space-s);
    border-left: var(--rule-strong) var(--border-style) var(--border);
  }

  .role__prose :global(h2) {
    display: none;
  }

  .role__prose :global(p) {
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  @media (max-width: 48rem) {
    .role {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }

    .role__when {
      position: static;
      flex-direction: row;
      align-items: center;
      gap: var(--space-2xs);
    }
  }
</style>
