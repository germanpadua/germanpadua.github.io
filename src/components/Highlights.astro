---
import { getHighlights } from '../lib/content';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const entries = await getHighlights(locale);
---

<section id="highlights" class="section">
  <div class="container">
    <header class="section-head reveal">
      <h2>{t.sections.highlights.title}</h2>
      <p class="section-head__lead">{t.sections.highlights.lead}</p>
    </header>

    <ul class="highlights" role="list">
      {
        entries.map((entry) => {
          const { data } = entry;
          const soft = data.headline && data.headline.basis !== 'artifact' && data.headline.basis !== 'record';
          return (
            <li class="highlight reveal">
              <div class="highlight__top">
                <span class="highlight__kind">{t.highlightsExtra.kinds[data.kind]}</span>
                <span class="highlight__period tabular">{data.period}</span>
              </div>

              {data.headline && (
                <p class:list={['highlight__headline', { 'highlight__headline--soft': soft }]}>
                  <span class="highlight__value tabular">{data.headline.value}</span>
                  <span class="highlight__caption">{data.headline.label}</span>
                </p>
              )}

              <h3 class="highlight__title">{data.title}</h3>
              <p class="highlight__issuer">{data.issuer}</p>
              <p class="highlight__summary">{data.summary}</p>

              {data.contribution && (
                <p class="highlight__contribution">
                  <strong>{t.projects.contribution}:</strong> {data.contribution}
                </p>
              )}

              {data.limits.length > 0 && (
                <details class="highlight__limits">
                  <summary>{t.projects.limits}</summary>
                  <ul role="list">
                    {data.limits.map((limit) => (
                      <li>{limit}</li>
                    ))}
                  </ul>
                </details>
              )}

              {data.links.url && (
                <p class="highlight__link">
                  <a href={data.links.url} rel="noopener noreferrer" target="_blank">
                    {data.links.label ?? data.links.url}
                  </a>
                </p>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--rule) var(--border-style) var(--border);
  }

  .highlight {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-l) var(--space-m) var(--space-m);
    border-bottom: var(--rule) var(--border-style) var(--border);
  }

  .highlight:first-child {
    padding-left: 0;
  }

  .highlight:last-child {
    padding-right: 0;
  }

  .highlight + .highlight {
    border-left: var(--rule) var(--border-style) var(--border);
  }

  .highlight__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .highlight__kind {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-muted);
  }

  .highlight__period {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .highlight__headline {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: var(--space-3xs);
  }

  .highlight__value {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    line-height: 1;
    color: var(--accent);
    letter-spacing: var(--tracking-tight);
  }

  .highlight__headline--soft .highlight__value {
    color: var(--warn);
  }

  .highlight__caption {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    max-width: 22ch;
  }

  .highlight__title {
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--fg-strong);
    margin-top: var(--space-3xs);
  }

  .highlight__issuer {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .highlight__summary {
    font-size: var(--text-body);
    line-height: var(--leading-normal);
    color: var(--fg);
  }

  .highlight__contribution {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    border-left: var(--rule-strong) var(--border-style) var(--border);
    padding-left: var(--space-xs);
  }

  .highlight__contribution strong {
    color: var(--fg-strong);
  }

  .highlight__limits {
    margin-top: var(--space-3xs);
  }

  .highlight__limits summary {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-muted);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .highlight__limits summary::-webkit-details-marker {
    display: none;
  }

  .highlight__limits summary::before {
    content: "+";
    color: var(--accent);
  }

  .highlight__limits[open] summary::before {
    content: "−";
  }

  .highlight__limits ul {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .highlight__limits li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--fg-muted);
  }

  .highlight__limits li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.4rem;
    height: var(--rule);
    background-color: var(--border-strong);
  }

  .highlight__link {
    margin-top: var(--space-3xs);
    font-size: var(--text-sm);
  }

  @media (max-width: 60rem) {
    .highlights {
      grid-template-columns: 1fr;
    }

    .highlight {
      padding-inline: 0;
    }

    .highlight + .highlight {
      border-left: none;
    }
  }
</style>
